  "version": {"major":3,"minor":1},
  "do_communications_commitment": true,
  "inputs": [
    {"name":"%v.0","type":"Scalar<BLS12-381>"}
  ],
  "outputs": [
  ],
  "instructions": [
    {"op":"public_input","guard":null,"type":"Scalar<BLS12-381>","output":"%state.1"},
    {"op":"impact","guard":"0x01","inputs":["0x30"]},
    {"op":"impact","guard":"0x01","inputs":["0x50","0x01","0x01","0x02"]},
    {"op":"impact","guard":"0x01","inputs":["0x0c","0x01","0x01","%state.1"]},
    {"op":"test_eq","a":"%state.1","b":"0x00","output":"%t.2"},
    {"op":"assert","cond":"%t.2"},
    {"op":"private_input","guard":null,"type":"Scalar<BLS12-381>","output":"%sk.3"},
    {"op":"constrain_bits","val":"%sk.3","bits":8},
    {"op":"private_input","guard":null,"type":"Scalar<BLS12-381>","output":"%sk.4"},
    {"op":"constrain_bits","val":"%sk.4","bits":248},
    {"op":"persistent_hash","alignment":[{"tag":"atom","value":{"tag":"bytes","length":32}},{"tag":"atom","value":{"tag":"bytes","length":32}}],"inputs":["0x00","0x6c617265733a74696e793a706b3a","%sk.3","%sk.4"],"output":"%bytes.5"},
    {"op":"bytes_into_natives","bytes":"%bytes.5","outputs":["%hash.6","%hash.7"]},
    {"op":"impact","guard":"0x01","inputs":["0x10","0x01","0x01","0x01","0x00"]},
    {"op":"impact","guard":"0x01","inputs":["0x11","0x01","0x01","0x20","%hash.7","%hash.6"]},
    {"op":"impact","guard":"0x01","inputs":["0x91"]},
    {"op":"impact","guard":"0x01","inputs":["0x10","0x01","0x01","0x01","0x01"]},
    {"op":"impact","guard":"0x01","inputs":["0x11","0x01","0x01","0xfffffffffefffffffe5bfeff02a4bd5305d8a10908d83933487d9d2953a7ed73","%v.0"]},
    {"op":"impact","guard":"0x01","inputs":["0x91"]},
