{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
  ],
  "outputs": [
    "Scalar<BLS12-381>",
    "Scalar<BLS12-381>"
  ],
  "instructions": [
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%state.0", "guard": null },
    { "op": "impact", "guard": "0x01", "inputs": ["0x30"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x50", "0x01", "0x01", "0x02"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0c", "0x01", "0x01", "%state.0"] },
    { "op": "test_eq", "output": "%t.1", "a": "%state.0", "b": "0x01" },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%value.2", "guard": "%t.1" },
    { "op": "impact", "guard": "%t.1", "inputs": ["0x30"] },
    { "op": "impact", "guard": "%t.1", "inputs": ["0x50", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "%t.1", "inputs": ["0x0c", "0x01", "-0x02", "%value.2"] },
    { "op": "cond_select", "output": "%t.3", "bit": "%t.1", "a": "%value.2", "b": "0x00" },
    { "op": "output", "vals": ["%t.1", "%t.3"] }
  ]
}

