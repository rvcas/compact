					result: [color, bal],
					context
				};
			},
			inspect_caller: (context) => {
				return {
					result: __compactRuntime.kernel.caller(context),
					context
				};
			}
		};
		this.circuits = {
			check_time_window: (context, now_bound) => {
				__compactRuntime.assert(_blockTimeGte(context, __compactRuntime.readCell(context, 0)), "too early");
				__compactRuntime.assert(_blockTimeLt(context, now_bound), "window expired");
				__compactRuntime.assert(!__compactRuntime.counterLessThan(context, 1, 0n), "counter non-negative");
				return {
					result: _blockTimeLte(context, now_bound) && _blockTimeGt(context, 0n),
					context
				};
			},
			mint_shielded_reward: (context, domain_sep, amount, seed) => {
				const pk = __compactRuntime.ownPublicKey(context);
				const nonce = _evolveNonce(0n, seed);
				const recipient = {
					is_left: true,
					left: pk,
					right: { bytes: new Uint8Array(32) }
				};
				const coin = _mintShieldedToken(context, domain_sep, amount, nonce, recipient);
				__compactRuntime.queryLedger(context, [
					{ idx: {
						cached: false,
						pushPath: true,
						path: 1
					} },
					{ addi: { immediate: 1 } },
					{ ins: {
						cached: true,
						n: 1
					} }
				]);
				__compactRuntime.kernel.checkpoint(context);
				return {
					result: coin,
					context
				};
			},
			manage_unshielded: (context, domain_sep, amount, user) => {
				const recipient = {
					is_left: false,
					left: { bytes: new Uint8Array(32) },
					right: user
				};
				const color = _mintUnshieldedToken(context, domain_sep, amount, recipient);
				_receiveUnshielded(context, color, 10n);
				__compactRuntime.assert(_unshieldedBalanceGte(context, color, 0n), "balance check");
				const bal = _unshieldedBalance(context, color);
				_sendUnshielded(context, color, 5n, recipient);
				return {
					result: [color, bal],
					context
				};
			},
			inspect_caller: (context) => {
				return {
					result: __compactRuntime.kernel.caller(context),
					context
				};
			}
		};
	}
	initialState(context, unlock_time) {
		__compactRuntime.writeCell(context, 0, unlock_time);
		return __compactRuntime.emptyContractState(context);
	}
}

