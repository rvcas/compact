import * as __compactRuntime from "@midnight-ntwrk/compact-runtime";
type Pair_Field_AccountId = {
	first: bigint;
	second: AccountId;
};
export type AccountId = Uint8Array;
function _bump_two(context: __compactRuntime.CircuitContext<unknown>): [] {
	for (let i: bigint = 0n; i < 2n; i = i + 1n) {
		__compactRuntime.queryLedger(context, [
			{ idx: {
				cached: false,
				pushPath: true,
				path: 0
			} },
			{ addi: { immediate: 1 } },
			{ ins: {
				cached: true,
				n: 1
			} }
		]);
	}
}
function _first_Field_AccountId(p: Pair_Field_AccountId): bigint {
	return p.first;
}
