import CompactStandardLibrary;

export ledger balances: Map<Field, Counter>;
export ledger nested: Map<Boolean, Map<Field, Counter>>;
export ledger queue: List<Field>;
export ledger queues_by_key: Map<Field, List<Field>>;
export ledger members: Set<Field>;

export circuit init_nested(): [] {
  nested.insert(true, default<Map<Field, Counter>>);
  nested.insert(false, default<Map<Field, Counter>>);
  nested.lookup(true).insert(1 as Field, default<Counter>);
  nested.lookup(false).insert(2 as Field, default<Counter>);
  nested.lookup(false).lookup(2 as Field).increment(2 * 3);
}

export circuit enqueue_batch(items: Vector<3, Field>): Uint<64> {
  for (const x of items) {
    queue.pushFront(disclose(x));
  }
  return queue.length();
}

export circuit seed_range(): [] {
  for (const i of 0..4) {
    balances.insertDefault(i as Field);
    members.insert(i as Field);
  }
}

export circuit check_bounds(a: Uint<32>, b: Uint<32>, limit: Uint<64>): Boolean {
  const prod = a * b;
  return a < b && a <= b && b > a && b >= a && prod <= limit;
}

export circuit manage_queue(key: Field, item: Field): Maybe<Field> {
  const dk = disclose(key);
  if (!queues_by_key.member(dk)) {
    queues_by_key.insertDefault(dk);
  }
  queues_by_key.lookup(dk).pushFront(disclose(item));
  const h = queues_by_key.lookup(dk).head();
  if (!queue.isEmpty()) {
    queue.popFront();
  }
  return h;
}

export circuit reset_all(): [] {
  balances.resetToDefault();
  nested.resetToDefault();
  queue.resetToDefault();
  queues_by_key.resetToDefault();
  members.resetToDefault();
}
